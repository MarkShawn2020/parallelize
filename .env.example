# One OpenRouter key serves both the LLM (System 2) and Jev (System 1).
OPENROUTER_API_KEY=

# System 2: any OpenAI-compatible chat endpoint.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_API_KEY defaults to OPENROUTER_API_KEY.
LLM_API_KEY=

# System 1: Jev systemone endpoint (OpenRouter or https://api.typesafe.ai/v1).
JEV_BASE_URL=https://openrouter.ai/api/v1
JEV_MODEL=typesafe/jev-1.13
# JEV_API_KEY defaults to OPENROUTER_API_KEY.
JEV_API_KEY=

# Server bind. Use HOST=0.0.0.0 only on a trusted stage network.
HOST=127.0.0.1
PORT=8787
